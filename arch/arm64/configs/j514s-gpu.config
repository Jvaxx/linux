# J514S/J516S (MacBook Pro 14/16-inch, M3 Pro, T6030) GPU fragment: the G15
# generation of the asahi driver, which drives the firmware the boot loader
# leaves loaded.
#
# Merge after defconfig and asahi.config:
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/asahi.config arch/arm64/configs/j514s-gpu.config
#   make olddefconfig
#
# The asahi driver selects the generation on apple,agx-t6030 through
# asahi.m3_backend (default on the J514S and J516S; asahi.m3_backend=runtime
# keeps the M3 runtime). The AGX vote goes through the T6030 PMP, which the
# display gate adds; the PMP driver must be reachable from the GPU driver.
CONFIG_DRM_ASAHI=m
CONFIG_DRM_ASAHI_G15=y
CONFIG_APPLE_PMP=m
