# J514S (MacBook Pro 14-inch, M3 Pro, T6030) fragment.
#
# Merge after defconfig and asahi.config:
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/asahi.config arch/arm64/configs/j514s.config
#   make olddefconfig
# A distribution configuration can merge this fragment instead (merge_config.sh -m
# on its .config, then olddefconfig).
#
# The internal display is the common Apple display driver (appledrm), which
# userspace loads explicitly; it adopts the running DCP session.
# The GPU is the asahi driver's G15 generation (j514s-rust.config): its platform
# driver has no module alias, so userspace runs "modprobe asahi" after the
# native display is up.

# The T6030 PMP and GPU device tree handoff (built in) adds nodes before devices
# are populated: it needs dynamic device trees.
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y

# PMP: display hold, AGX vote and the DCS4/FAB2 memory floor
CONFIG_APPLE_PMP=m

# Internal display: the common Apple display driver (appledrm) with its J514S
# (DCP firmware 14.7) profile. Userspace loads it explicitly, before the GPU.
CONFIG_BACKLIGHT_CLASS_DEVICE=m
CONFIG_DRM_APPLE=m
CONFIG_DRM_APPLE_DCP_T6030=y

# USB-C external displays: the external display coprocessor (DCPEXT1) on the
# same driver, its PMP device-state power domain, the USB-C display crossbars
# and the DisplayPort mode of the Type-C PHYs. The boot loader publishes
# DCPEXT1 with its firmware reservations.
CONFIG_DRM_APPLE_DCP_T6030_EXT=y
CONFIG_APPLE_PMP_T6030_PTD=m
CONFIG_MUX_APPLE_DPXBAR_T6030=y
CONFIG_PHY_APPLE_ATC_T6030_DP=y

# Built-in HDMI audio: DCPEXT0's audio service and DPA1, whose samples the
# SIO coprocessor's channel 0x66 carries (APPLE_SIO, DRM_APPLE_AUDIO from
# asahi.config), with the T6030 SIO channel configuration. The boot loader
# hands the SIO firmware over. Userspace opts in to DP/HDMI audio with
# appledrm.hdmi_audio=1, as on the other Apple machines.
CONFIG_APPLE_SIO_T6030=y
