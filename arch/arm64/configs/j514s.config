# J514S (MacBook Pro 14-inch, M3 Pro, T6030) fragment.
#
# Merge after defconfig and asahi.config:
#   make defconfig
#   scripts/kconfig/merge_config.sh -m .config arch/arm64/configs/asahi.config arch/arm64/configs/j514s.config
#   make olddefconfig
# A distribution configuration can merge this fragment instead (merge_config.sh -m
# on its .config, then olddefconfig).

# The T6030 PMP and GPU device tree handoff (built in) adds nodes before devices
# are populated: it needs dynamic device trees.
CONFIG_OF_OVERLAY=y
CONFIG_OF_DYNAMIC=y

# PMP: display hold, AGX vote and the DCS4/FAB2 memory floor
CONFIG_APPLE_PMP=m
