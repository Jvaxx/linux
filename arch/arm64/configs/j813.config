# Minimal RAM-only J813 bring-up; use with KCONFIG_ALLCONFIG and allnoconfig.
CONFIG_LOCALVERSION="-aurora-j813-wip"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_SMP=y
CONFIG_NR_CPUS=16
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_ARM64_VHE=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_LOG_BUF_SHIFT=20
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
