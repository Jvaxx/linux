# SPDX-License-Identifier: GPL-2.0-only OR MIT
# J713 (13-inch M4 MacBook Air) basic platform, using the firmware framebuffer.
# Merge after arm64 defconfig and asahi.config, then run olddefconfig.
# Companion m1n1/U-Boot retained-input and per-kernel DTB handoffs are required.

# Limit this device-specific configuration to Apple platform support.
CONFIG_ARCH_APPLE=y
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BITMAIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_MEDIATEK is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_LAN969X is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_MMP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_PENSANDO is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set
CONFIG_NR_CPUS=16
# Keep virtualization disabled as in the previous basic configuration.
# CONFIG_KVM is not set
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_OF_DYNAMIC=y

# Keep the boot storage, retained input and platform owners available early.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_RD_XZ=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
# CONFIG_HID_APPLE_MTP_HAPTIC is not set
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_MFD_MACSMC=y
CONFIG_GPIO_MACSMC=y
CONFIG_POWER_RESET_MACSMC=y
CONFIG_MACSMC_POWER=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_I2C_APPLE=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_APPLE_WATCHDOG=y

# Retain the qualified memory floors and CPU thermal ownership policy.
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_APPLE_PMP=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_APPLE_PMP_THERMAL=y
CONFIG_APPLE_MCC=y
CONFIG_APPLE_PMC=y
CONFIG_APPLE_CLPC=y
CONFIG_APPLE_T8132_PLATFORM_HANDOFF=y
# CONFIG_SENSORS_APPLE_PMP_J613 is not set

# USB2 Type-C routing and the J713 radio.
CONFIG_PHY_APPLE_ATC=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_MUX_APPLE_DPXBAR=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_BRCMFMAC=m
CONFIG_BRCMFMAC_PCIE=y
CONFIG_SPI_APPLE_QSPI=m

# Retain policy routing and packet filters used by the installed network stack.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_CONNTRACK_EVENTS=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_MARK=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m

# Preserve the userspace and peripheral requirements of the working system.
CONFIG_PSI=y
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_DM_CRYPT=m
CONFIG_DM_INTEGRITY=m
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_UHID=m
CONFIG_HID_LOGITECH=m
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_HID_STEAM=m
CONFIG_HID_WACOM=m
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_PRINTER=m
CONFIG_USB_UAS=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y

# Basic bring-up uses the inherited display; native graphics are a later series.
CONFIG_DRM_SIMPLEDRM=y
# CONFIG_DRM_ASAHI is not set
# CONFIG_DRM_APPLE is not set
# CONFIG_DRM_ADP is not set
# CONFIG_DRM_ACCEL_ANE is not set
# CONFIG_APPLE_SEP is not set
