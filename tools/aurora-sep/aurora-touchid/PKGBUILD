            'e1b1152e576e9588cc134b09291b3a2306ac686d9a47be6f128670608da535fc')

package() {
  install -Dm755 aurora-touchid-setup "$pkgdir/usr/bin/aurora-touchid-setup"
  install -Dm755 extract-mesa-calibration "$pkgdir/usr/lib/aurora-touchid/extract-mesa-calibration"
  install -Dm644 apple-sep.service "$pkgdir/usr/lib/systemd/system/apple-sep.service"
  install -Dm644 apple-sep.path "$pkgdir/usr/lib/systemd/system/apple-sep.path"
  install -Dm644 fprintd-aurora.conf "$pkgdir/usr/lib/systemd/system/fprintd.service.d/aurora.conf"
