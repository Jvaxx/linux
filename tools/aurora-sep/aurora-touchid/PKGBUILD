source=('aurora-touchid-setup'
        'extract-mesa-calibration'
        'apple-sep.service'
        'apple-sep.path'
        'fprintd-aurora.conf')
sha256sums=('ab4ed299d03462210e03e8d4152803a414204ebf25ec0f065b1b7dc3d43667b1'
            '2e1d50b5274223e107e4aa4f73de194f3a49d347be1edc93efd3f81b31b092cc'
            '4f7b8a97e35e3511afa482ee8aedd019e960b1a67320675bd347f534feab49c3'
